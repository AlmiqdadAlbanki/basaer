# Basaer server configuration. Installed as /etc/basaer.env (mode 0640 root:basaer).
# Read by systemd (EnvironmentFile=), so no "export" and no shell expansion.

# "production" disables the /dev/* endpoints. Keep it.
NODE_ENV=production

# Port the Node server listens on. Caddy proxies to it; do not open it in the firewall.
PORT=3000

# PLACEHOLDER DOMAIN: replace with your real public URL. Used to build file links.
BASE_URL=https://app.basaerbh.com

# SQLite database (WAL mode, so -wal and -shm files appear beside it).
BASAER_DB=/var/lib/basaer/basaer.sqlite

# RSA signing keys. Losing them logs every user out.
BASAER_KEYS=/var/lib/basaer/keys

# Uploaded files and generated documents (the local replacement for Google Drive).
# The tools (seed, register-template, make-demo-templates) read this too.
BASAER_FILES=/var/lib/basaer/files

# *** WARNING ***
# dry-run records emails, WhatsApp messages and push notifications without sending them.
# live SENDS REAL email, WhatsApp and push messages to real students and parents.
# Only switch to live after the data is loaded and SMTP is tested.
OUTBOUND_MODE=dry-run

# SMTP for live email (leave blank while in dry-run).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender address, and the owner address that receives admin notices.
MAIL_FROM=Basaer <no-reply@basaerbh.com>
OWNER_EMAIL=admin@basaerbh.com

# Set to any value to print the Apps Script Logger output to the journal (noisy).
# BASAER_LOG=1

# Override binary locations for document conversion (defaults are found on PATH).
# BASAER_SOFFICE=/usr/bin/soffice
# BASAER_PDFTOPPM=/usr/bin/pdftoppm
